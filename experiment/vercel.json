{
  "framework": "vite",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/page.js": { "includeFiles": "dist/index.html", "maxDuration": 10 },
    "api/og.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/join/:token", "destination": "/api/page?token=:token" },
    { "source": "/i/:token", "destination": "/api/page?token=:token" },
    { "source": "/:slug([a-z0-9][a-z0-9-]{1,38}[a-z0-9])/:token([A-Za-z0-9_-]{10,64})", "destination": "/api/page?slug=:slug&token=:token" },
    { "source": "/:slug([a-z0-9][a-z0-9-]{1,38}[a-z0-9])", "destination": "/api/page?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
