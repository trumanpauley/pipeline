{
  "name": "pipeline-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO=1 VITE_DEMO_LOCAL=1 VITE_PHONE_AUTH=1 VITE_HASH_ROUTER=1 VITE_SUPABASE_URL=http://local.demo VITE_SUPABASE_PUBLISHABLE_KEY=demo vite build --base ./ --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e.mjs",
    "test:mobile": "node test/mobile.mjs",
    "demo": "node test/demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
