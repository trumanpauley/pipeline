# Supabase → Project Settings → API. Only the public anon/publishable key belongs here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: Cloudflare Turnstile site key (only if CAPTCHA is enabled in Supabase Auth)
# VITE_TURNSTILE_SITE_KEY=
